{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext", // บอก typescript ว่าให้ complie โดยเคารพกฎ module ของ Node.js รุ่นใหม่
    "target": "esnext", // บอก typescript ว่า javascript ที่ complie ออกมาให้ใช้ syntax ระดับไหน
    "moduleResolution":"nodenext", // บอก typescript ว่า เวลาเจอ import ให้หาไฟล์แบบ Node.js ESM
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    
    "verbatimModuleSyntax": true, // บอก typescript ว่าแอบปรับรูปแบบ import/export มั่วๆ ให้คง syntax ตามที่เราเขียน
    // เหมาะกับ ESM เพราะทำให้เราเห็นชัดว่าอะไรเป็น runtime import และอะไรเป็น type import 

    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true, // ช่วยให้ import package เก่าๆ ที่เป็น CommonJS ใช้ง่ายขึ้น
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
